---
// index.astro - Página de Inicio
import Layout from "../layouts/Layout.astro";
import '../styles/global.css';
---

<Layout title="Inicio">
	<!-- Hero Section -->
	<section
		class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-terracotta-800 text-white py-20 px-6 sm:px-12 rounded-b-3xl shadow-xl"
	>
		<div class="max-w-4xl mx-auto text-center space-y-6">
			<span
				class="inline-block px-3 py-1 bg-gold-500/20 text-gold-400 border border-gold-500/40 rounded-full text-xs font-semibold uppercase tracking-wider"
			>
				Espacio Cultural Comunitario
			</span>
			<h1
				class="font-serif text-4xl sm:text-6xl font-extrabold text-cream leading-tight"
			>
				Preservando Identidad, Impulsando Creatividad
			</h1>
			<p
				class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto font-light"
			>
				Un punto de encuentro comunitario para las artes plásticas,
				folclore, música y artes escénicas.
			</p>
			<div class="flex flex-wrap justify-center gap-4 pt-4">
				<a
					href="/talleres"
					class="bg-terracotta-500 hover:bg-terracotta-600 text-white font-semibold px-6 py-3 rounded-xl transition shadow-lg"
				>
					Inscribirse a Talleres
				</a>
				<a
					href="/nosotros"
					class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 font-semibold px-6 py-3 rounded-xl transition"
				>
					Conocer Sede y Equipo
				</a>
			</div>
		</div>
	</section>
</Layout>
