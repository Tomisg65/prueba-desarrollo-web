---
// nosotros.astro - Acerca de Nosotros
import Layout from "../layouts/Layout.astro";
import CardEquipo from "../components/CardEquipo.astro";
import '../styles/global.css';

const equipo = [
    {
        nombre: "Valeria Sepúlveda",
        cargo: "Directora General",
        imagen: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=200&q=80",
    },
    {
        nombre: "Gonzalo Fuentes",
        cargo: "Coordinador de Talleres",
        imagen: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=200&q=80",
    },
    {
        nombre: "Camila Ríos",
        cargo: "Gestora Cultural",
        imagen: "https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=200&q=80",
    },
];
---

<Layout title="Nosotros">
    <div class="max-w-5xl mx-auto px-6 py-12 space-y-12">
        <div class="text-center max-w-2xl mx-auto space-y-3">
            <span
                class="px-3 py-1 bg-olive-100 text-olive-700 rounded-full text-xs font-bold uppercase"
                >Nuestra Identidad</span
            >
            <h1 class="font-serif text-4xl font-extrabold text-slate-900">
                Historia y Equipo Directivo
            </h1>
            <p class="text-slate-600 text-sm">
                Más de 15 años impulsando la cultura comunitaria.
            </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
            {equipo.map((persona) => <CardEquipo {...persona} />)}
        </div>
    </div>
</Layout>
