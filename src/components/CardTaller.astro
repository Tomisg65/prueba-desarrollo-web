---
// CardTaller.astro - Tarjeta de Taller
export interface Props {
    titulo: string;
    categoria: string;
    descripcion: string;
    profesor: string;
    horario: string;
    cupos: number;
    imagen: string;
}

const { titulo, categoria, descripcion, profesor, horario, cupos, imagen } =
    Astro.props;
---

<div
    class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col"
>
    <div class="relative h-48">
        <img src={imagen} alt={titulo} class="w-full h-full object-cover" />
        <span
            class="absolute top-3 right-3 bg-slate-900/80 backdrop-blur text-white text-[10px] font-bold px-2.5 py-1 rounded-md"
        >
            {categoria}
        </span>
    </div>
    <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
        <div>
            <h3 class="font-serif font-bold text-lg text-slate-900">
                {titulo}
            </h3>
            <p class="text-xs text-slate-600 mt-1">{descripcion}</p>
        </div>
        <div
            class="space-y-2 text-xs text-slate-500 border-t border-slate-100 pt-3"
        >
            <p>👤 {profesor}</p>
            <p>⏰ {horario}</p>
            <p>
                👥 Cupos disponibles: <strong class="text-slate-800"
                    >{cupos}</strong>
            </p>
        </div>
        <button
            class="w-full py-2 bg-slate-900 hover:bg-terracotta-600 text-white rounded-lg text-xs font-semibold transition"
        >
            Inscribirme
        </button>
    </div>
</div>
